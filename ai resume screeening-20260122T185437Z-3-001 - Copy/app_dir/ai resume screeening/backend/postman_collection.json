                            "mode": "raw",
                            "raw": "{\n  \"email\": \"recruiter@test.com\",\n  \"password\": \"test123\",\n  \"full_name\": \"Test Recruiter\",\n  \"role\": \"recruiter\",\n  \"department\": \"HR\"\n}"
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.environment.set(\"token\", jsonData.access_token);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
